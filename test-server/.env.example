# Named tunnel mode (set TUNNEL_TOKEN or provide credentials file)
TUNNEL_TOKEN=eyJhIjoiYWNjb3VudC10YWciLCJzIjoic2VjcmV0IiwidCI6InR1bm5lbC1pZC1oZXJlIn0=

# OR use a credentials file (created by `cloudflared tunnel create`)
# TUNNEL_CREDENTIALS=/path/to/credentials.json

# Quick tunnel mode (anonymous, no account needed) — uncomment to use:
# TUNNEL_QUICK=true

# Local port to forward
TUNNEL_PORT=8080

# Number of HA connections (1-4, default 1)
# TUNNEL_HA_CONNECTIONS=1
